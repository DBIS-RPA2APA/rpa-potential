{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutomationClassification",
  "type": "object",
  "properties": {
    "processId": { "type": "string" },
    "model": { "type": "string" },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "isAutomatable": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 3 }
        },
        "required": ["id", "isAutomatable", "reason"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["processId", "model", "activities"],
  "additionalProperties": false
}