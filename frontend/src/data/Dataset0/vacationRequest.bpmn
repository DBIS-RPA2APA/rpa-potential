<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_Vacation"
  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:message id="Message_VacationRequest" name="vacation request"/>
  <bpmn:message id="Message_VacationDecision" name="decision"/>

  <bpmn:process id="Process_Employee" isExecutable="false">
    <bpmn:startEvent id="E_Start" name="Need vacation">
      <bpmn:outgoing>E_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="E_Submit" name="Submit request">
      <bpmn:incoming>E_F1</bpmn:incoming>
      <bpmn:outgoing>E_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="E_WaitDecision" name="Decision received">
      <bpmn:incoming>E_F2</bpmn:incoming>
      <bpmn:outgoing>E_F3</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_VacationDecision"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E_End" name="Done">
      <bpmn:incoming>E_F3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="E_F1" sourceRef="E_Start" targetRef="E_Submit"/>
    <bpmn:sequenceFlow id="E_F2" sourceRef="E_Submit" targetRef="E_WaitDecision"/>
    <bpmn:sequenceFlow id="E_F3" sourceRef="E_WaitDecision" targetRef="E_End"/>
  </bpmn:process>

  <bpmn:process id="Process_Manager" isExecutable="false">
    <bpmn:startEvent id="M_Start" name="Request received">
      <bpmn:outgoing>M_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_VacationRequest"/>
    </bpmn:startEvent>
    <bpmn:task id="M_Review" name="Review request">
      <bpmn:incoming>M_F1</bpmn:incoming>
      <bpmn:outgoing>M_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="M_GW" name="Approve?">
      <bpmn:incoming>M_F2</bpmn:incoming>
      <bpmn:outgoing>M_F3</bpmn:outgoing>
      <bpmn:outgoing>M_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_Approve" name="Send approval">
      <bpmn:incoming>M_F3</bpmn:incoming>
      <bpmn:outgoing>M_F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M_Reject" name="Send rejection">
      <bpmn:incoming>M_F4</bpmn:incoming>
      <bpmn:outgoing>M_F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="M_End" name="Done">
      <bpmn:incoming>M_F5</bpmn:incoming>
      <bpmn:incoming>M_F6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="M_F1" sourceRef="M_Start" targetRef="M_Review"/>
    <bpmn:sequenceFlow id="M_F2" sourceRef="M_Review" targetRef="M_GW"/>
    <bpmn:sequenceFlow id="M_F3" sourceRef="M_GW" targetRef="M_Approve"/>
    <bpmn:sequenceFlow id="M_F4" sourceRef="M_GW" targetRef="M_Reject"/>
    <bpmn:sequenceFlow id="M_F5" sourceRef="M_Approve" targetRef="M_End"/>
    <bpmn:sequenceFlow id="M_F6" sourceRef="M_Reject" targetRef="M_End"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_Vacation">
    <bpmn:participant id="Participant_Employee" name="Employee" processRef="Process_Employee"/>
    <bpmn:participant id="Participant_Manager" name="Manager" processRef="Process_Manager"/>

    <bpmn:messageFlow id="MF_VacationRequest" name="vacation request"
      sourceRef="E_Submit" targetRef="M_Start" messageRef="Message_VacationRequest"/>
    <bpmn:messageFlow id="MF_VacationDecision_Approved" name="decision"
      sourceRef="M_Approve" targetRef="E_WaitDecision" messageRef="Message_VacationDecision"/>
    <bpmn:messageFlow id="MF_VacationDecision_Rejected" name="decision"
      sourceRef="M_Reject" targetRef="E_WaitDecision" messageRef="Message_VacationDecision"/>
  </bpmn:collaboration>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Vacation">
    <bpmndi:BPMNPlane id="BPMNPlane_Vacation" bpmnElement="Collaboration_Vacation">

      <!-- Pools -->
      <bpmndi:BPMNShape id="Participant_Employee_di" bpmnElement="Participant_Employee" isHorizontal="true">
        <dc:Bounds x="50" y="50" width="900" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Manager_di" bpmnElement="Participant_Manager" isHorizontal="true">
        <dc:Bounds x="50" y="270" width="900" height="220"/>
      </bpmndi:BPMNShape>

      <!-- Employee flow nodes -->
      <bpmndi:BPMNShape id="E_Start_di" bpmnElement="E_Start">
        <dc:Bounds x="120" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Submit_di" bpmnElement="E_Submit">
        <dc:Bounds x="220" y="105" width="120" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_WaitDecision_di" bpmnElement="E_WaitDecision">
        <dc:Bounds x="390" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_End_di" bpmnElement="E_End">
        <dc:Bounds x="480" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Manager flow nodes -->
      <bpmndi:BPMNShape id="M_Start_di" bpmnElement="M_Start">
        <dc:Bounds x="120" y="360" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_Review_di" bpmnElement="M_Review">
        <dc:Bounds x="220" y="345" width="140" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_GW_di" bpmnElement="M_GW">
        <dc:Bounds x="400" y="357" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_Approve_di" bpmnElement="M_Approve">
        <dc:Bounds x="520" y="315" width="140" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_Reject_di" bpmnElement="M_Reject">
        <dc:Bounds x="520" y="395" width="140" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_End_di" bpmnElement="M_End">
        <dc:Bounds x="720" y="360" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Sequence flow edges (Employee) -->
      <bpmndi:BPMNEdge id="E_F1_di" bpmnElement="E_F1">
        <di:waypoint x="156" y="138"/>
        <di:waypoint x="220" y="138"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F2_di" bpmnElement="E_F2">
        <di:waypoint x="340" y="138"/>
        <di:waypoint x="390" y="138"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F3_di" bpmnElement="E_F3">
        <di:waypoint x="426" y="138"/>
        <di:waypoint x="480" y="138"/>
      </bpmndi:BPMNEdge>

      <!-- Sequence flow edges (Manager) -->
      <bpmndi:BPMNEdge id="M_F1_di" bpmnElement="M_F1">
        <di:waypoint x="156" y="378"/>
        <di:waypoint x="220" y="378"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M_F2_di" bpmnElement="M_F2">
        <di:waypoint x="360" y="378"/>
        <di:waypoint x="400" y="382"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M_F3_di" bpmnElement="M_F3">
        <di:waypoint x="450" y="382"/>
        <di:waypoint x="520" y="348"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M_F4_di" bpmnElement="M_F4">
        <di:waypoint x="450" y="382"/>
        <di:waypoint x="520" y="428"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M_F5_di" bpmnElement="M_F5">
        <di:waypoint x="660" y="348"/>
        <di:waypoint x="738" y="378"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M_F6_di" bpmnElement="M_F6">
        <di:waypoint x="660" y="428"/>
        <di:waypoint x="738" y="378"/>
      </bpmndi:BPMNEdge>

      <!-- Message flows -->
      <bpmndi:BPMNEdge id="MF_VacationRequest_di" bpmnElement="MF_VacationRequest">
        <di:waypoint x="280" y="171"/>
        <di:waypoint x="138" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_VacationDecision_Approved_di" bpmnElement="MF_VacationDecision_Approved">
        <di:waypoint x="590" y="315"/>
        <di:waypoint x="408" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_VacationDecision_Rejected_di" bpmnElement="MF_VacationDecision_Rejected">
        <di:waypoint x="590" y="395"/>
        <di:waypoint x="408" y="120"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
