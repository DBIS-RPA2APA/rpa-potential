<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Invoice" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Invoice" isExecutable="false">
    <bpmn:startEvent id="I_Start" name="Invoice received">
      <bpmn:outgoing>I_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="I_Validate" name="Validate invoice">
      <bpmn:incoming>I_F1</bpmn:incoming>
      <bpmn:outgoing>I_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="I_GW" name="Correct?">
      <bpmn:incoming>I_F2</bpmn:incoming>
      <bpmn:outgoing>I_F3</bpmn:outgoing>
      <bpmn:outgoing>I_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="I_Pay" name="Pay invoice">
      <bpmn:incoming>I_F3</bpmn:incoming>
      <bpmn:outgoing>I_F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="I_Clarify" name="Request clarification">
      <bpmn:incoming>I_F4</bpmn:incoming>
      <bpmn:outgoing>I_F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="I_End" name="Done">
      <bpmn:incoming>I_F5</bpmn:incoming>
      <bpmn:incoming>I_F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="I_F1" sourceRef="I_Start" targetRef="I_Validate" />
    <bpmn:sequenceFlow id="I_F2" sourceRef="I_Validate" targetRef="I_GW" />
    <bpmn:sequenceFlow id="I_F3" sourceRef="I_GW" targetRef="I_Pay" />
    <bpmn:sequenceFlow id="I_F4" sourceRef="I_GW" targetRef="I_Clarify" />
    <bpmn:sequenceFlow id="I_F5" sourceRef="I_Pay" targetRef="I_End" />
    <bpmn:sequenceFlow id="I_F6" sourceRef="I_Clarify" targetRef="I_End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Invoice">
    <bpmndi:BPMNPlane id="Plane_Invoice" bpmnElement="Process_Invoice">
      <bpmndi:BPMNShape id="I_Start_di" bpmnElement="I_Start">
        <dc:Bounds x="120" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I_Validate_di" bpmnElement="I_Validate" bioc:stroke="#dc2626" bioc:fill="#fee2e2" color:background-color="#fee2e2" color:border-color="#dc2626">
        <dc:Bounds x="210" y="105" width="150" height="66" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I_GW_di" bpmnElement="I_GW" isMarkerVisible="true">
        <dc:Bounds x="400" y="113" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I_Pay_di" bpmnElement="I_Pay">
        <dc:Bounds x="500" y="70" width="140" height="66" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I_Clarify_di" bpmnElement="I_Clarify" bioc:stroke="#dc2626" bioc:fill="#fee2e2" color:background-color="#fee2e2" color:border-color="#dc2626">
        <dc:Bounds x="500" y="150" width="170" height="66" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I_End_di" bpmnElement="I_End">
        <dc:Bounds x="720" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="I_F1_di" bpmnElement="I_F1">
        <di:waypoint x="156" y="138" />
        <di:waypoint x="210" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="I_F2_di" bpmnElement="I_F2">
        <di:waypoint x="360" y="138" />
        <di:waypoint x="400" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="I_F3_di" bpmnElement="I_F3">
        <di:waypoint x="450" y="138" />
        <di:waypoint x="500" y="103" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="I_F4_di" bpmnElement="I_F4">
        <di:waypoint x="450" y="138" />
        <di:waypoint x="500" y="183" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="I_F5_di" bpmnElement="I_F5">
        <di:waypoint x="640" y="103" />
        <di:waypoint x="738" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="I_F6_di" bpmnElement="I_F6">
        <di:waypoint x="670" y="183" />
        <di:waypoint x="738" y="138" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
