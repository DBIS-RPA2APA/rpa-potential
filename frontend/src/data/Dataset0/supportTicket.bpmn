<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_Support"
  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="Process_Support" isExecutable="false">
    <bpmn:startEvent id="Start" name="Ticket received">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Analyze" name="Analyze issue">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW" name="Can solve now?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Solve" name="Resolve issue">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Escalate" name="Escalate ticket">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End" name="Ticket closed">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Analyze"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Analyze" targetRef="GW"/>
    <bpmn:sequenceFlow id="F3" sourceRef="GW" targetRef="Solve"/>
    <bpmn:sequenceFlow id="F4" sourceRef="GW" targetRef="Escalate"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Solve" targetRef="End"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Escalate" targetRef="End"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_Support">
    <bpmndi:BPMNPlane id="Plane_Support" bpmnElement="Process_Support">

      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="120" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Analyze_di" bpmnElement="Analyze">
        <dc:Bounds x="210" y="105" width="140" height="66"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="GW_di" bpmnElement="GW">
        <dc:Bounds x="390" y="113" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Solve_di" bpmnElement="Solve">
        <dc:Bounds x="500" y="70" width="140" height="66"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Escalate_di" bpmnElement="Escalate">
        <dc:Bounds x="500" y="150" width="140" height="66"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="700" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="156" y="138"/>
        <di:waypoint x="210" y="138"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="350" y="138"/>
        <di:waypoint x="390" y="138"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="440" y="138"/>
        <di:waypoint x="500" y="103"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="440" y="138"/>
        <di:waypoint x="500" y="183"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="640" y="103"/>
        <di:waypoint x="718" y="138"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="640" y="183"/>
        <di:waypoint x="718" y="138"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
