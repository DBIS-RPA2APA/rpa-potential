<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_Order"
  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:message id="Message_Order" name="order"/>
  <bpmn:message id="Message_Confirmation" name="confirmation"/>
  <bpmn:message id="Message_Shipping" name="shipping notice"/>

  <bpmn:process id="Process_Customer" isExecutable="false">
    <bpmn:startEvent id="C_Start" name="Want to buy">
      <bpmn:outgoing>C_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="C_PlaceOrder" name="Place order">
      <bpmn:incoming>C_F1</bpmn:incoming>
      <bpmn:outgoing>C_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="C_WaitConfirm" name="Order confirmed">
      <bpmn:incoming>C_F2</bpmn:incoming>
      <bpmn:outgoing>C_F3</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Confirmation"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C_WaitShip" name="Shipping notice">
      <bpmn:incoming>C_F3</bpmn:incoming>
      <bpmn:outgoing>C_F4</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Shipping"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="C_End" name="Receive order">
      <bpmn:incoming>C_F4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="C_F1" sourceRef="C_Start" targetRef="C_PlaceOrder"/>
    <bpmn:sequenceFlow id="C_F2" sourceRef="C_PlaceOrder" targetRef="C_WaitConfirm"/>
    <bpmn:sequenceFlow id="C_F3" sourceRef="C_WaitConfirm" targetRef="C_WaitShip"/>
    <bpmn:sequenceFlow id="C_F4" sourceRef="C_WaitShip" targetRef="C_End"/>
  </bpmn:process>

  <bpmn:process id="Process_Shop" isExecutable="false">
    <bpmn:startEvent id="S_Start" name="Order received">
      <bpmn:outgoing>S_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Order"/>
    </bpmn:startEvent>
    <bpmn:task id="S_CheckStock" name="Check stock">
      <bpmn:incoming>S_F1</bpmn:incoming>
      <bpmn:outgoing>S_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Confirm" name="Confirm order">
      <bpmn:incoming>S_F2</bpmn:incoming>
      <bpmn:outgoing>S_F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Ship" name="Ship item">
      <bpmn:incoming>S_F3</bpmn:incoming>
      <bpmn:outgoing>S_F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="S_End" name="Done">
      <bpmn:incoming>S_F4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="S_F1" sourceRef="S_Start" targetRef="S_CheckStock"/>
    <bpmn:sequenceFlow id="S_F2" sourceRef="S_CheckStock" targetRef="S_Confirm"/>
    <bpmn:sequenceFlow id="S_F3" sourceRef="S_Confirm" targetRef="S_Ship"/>
    <bpmn:sequenceFlow id="S_F4" sourceRef="S_Ship" targetRef="S_End"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_Order">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_Shop" name="Online Shop" processRef="Process_Shop"/>

    <bpmn:messageFlow id="MF_Order" name="order" sourceRef="C_PlaceOrder" targetRef="S_Start" messageRef="Message_Order"/>
    <bpmn:messageFlow id="MF_Confirm" name="confirmation" sourceRef="S_Confirm" targetRef="C_WaitConfirm" messageRef="Message_Confirmation"/>
    <bpmn:messageFlow id="MF_Shipping" name="shipping notice" sourceRef="S_Ship" targetRef="C_WaitShip" messageRef="Message_Shipping"/>
  </bpmn:collaboration>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Order">
    <bpmndi:BPMNPlane id="BPMNPlane_Order" bpmnElement="Collaboration_Order">

      <bpmndi:BPMNShape id="Participant_Customer_di" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="50" y="50" width="900" height="190"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Shop_di" bpmnElement="Participant_Shop" isHorizontal="true">
        <dc:Bounds x="50" y="280" width="900" height="200"/>
      </bpmndi:BPMNShape>

      <!-- Customer -->
      <bpmndi:BPMNShape id="C_Start_di" bpmnElement="C_Start">
        <dc:Bounds x="120" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_PlaceOrder_di" bpmnElement="C_PlaceOrder">
        <dc:Bounds x="210" y="105" width="120" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_WaitConfirm_di" bpmnElement="C_WaitConfirm">
        <dc:Bounds x="370" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_WaitShip_di" bpmnElement="C_WaitShip">
        <dc:Bounds x="450" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_End_di" bpmnElement="C_End">
        <dc:Bounds x="540" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Shop -->
      <bpmndi:BPMNShape id="S_Start_di" bpmnElement="S_Start">
        <dc:Bounds x="120" y="360" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_CheckStock_di" bpmnElement="S_CheckStock">
        <dc:Bounds x="210" y="345" width="140" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Confirm_di" bpmnElement="S_Confirm">
        <dc:Bounds x="390" y="345" width="140" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Ship_di" bpmnElement="S_Ship">
        <dc:Bounds x="570" y="345" width="140" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_di" bpmnElement="S_End">
        <dc:Bounds x="750" y="360" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Sequence edges customer -->
      <bpmndi:BPMNEdge id="C_F1_di" bpmnElement="C_F1">
        <di:waypoint x="156" y="138"/>
        <di:waypoint x="210" y="138"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C_F2_di" bpmnElement="C_F2">
        <di:waypoint x="330" y="138"/>
        <di:waypoint x="370" y="138"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C_F3_di" bpmnElement="C_F3">
        <di:waypoint x="406" y="138"/>
        <di:waypoint x="450" y="138"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C_F4_di" bpmnElement="C_F4">
        <di:waypoint x="486" y="138"/>
        <di:waypoint x="540" y="138"/>
      </bpmndi:BPMNEdge>

      <!-- Sequence edges shop -->
      <bpmndi:BPMNEdge id="S_F1_di" bpmnElement="S_F1">
        <di:waypoint x="156" y="378"/>
        <di:waypoint x="210" y="378"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S_F2_di" bpmnElement="S_F2">
        <di:waypoint x="350" y="378"/>
        <di:waypoint x="390" y="378"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S_F3_di" bpmnElement="S_F3">
        <di:waypoint x="530" y="378"/>
        <di:waypoint x="570" y="378"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S_F4_di" bpmnElement="S_F4">
        <di:waypoint x="710" y="378"/>
        <di:waypoint x="750" y="378"/>
      </bpmndi:BPMNEdge>

      <!-- Message flows -->
      <bpmndi:BPMNEdge id="MF_Order_di" bpmnElement="MF_Order">
        <di:waypoint x="270" y="171"/>
        <di:waypoint x="138" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Confirm_di" bpmnElement="MF_Confirm">
        <di:waypoint x="460" y="345"/>
        <di:waypoint x="388" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Shipping_di" bpmnElement="MF_Shipping">
        <di:waypoint x="640" y="345"/>
        <di:waypoint x="468" y="120"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
