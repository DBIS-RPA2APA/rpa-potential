# ----------------------------
# Dependencies
# ----------------------------
node_modules/

# ----------------------------
# Build / Output
# ----------------------------
dist/
build/
out/

# ----------------------------
# Environment / Secrets
# ----------------------------
.env
.env.local
.env.*.local

# ----------------------------
# Logs
# ----------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----------------------------
# Editor / IDE
# ----------------------------
.vscode/
.idea/
*.swp
*.swo

# ----------------------------
# OS specific
# ----------------------------
.DS_Store
Thumbs.db

# ----------------------------
# Temporary files
# ----------------------------
*.tmp
*.temp

# ----------------------------
# Optional: BPMN editor exports
# (only keep if you generate runtime files)
# ----------------------------
exports/

# ----------------------------
# Docker: dataset to evaluate (unpublished data, keep out of git)
# ----------------------------
dataset/*
!dataset/.gitkeep

# rerun datasets are copies of models from another dataset
backend/src/data/*_rerun/

# ablation datasets are copies of Dataset4 with a dataset.json
backend/src/data/*_labelsOnly/
backend/src/data/*_structureOnly/
