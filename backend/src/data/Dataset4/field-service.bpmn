    <bpmn:textAnnotation id="TextAnnotation_0scolb5">
      <bpmn:text>ATE Services:
- Expert Walk
- Expert Education
- Expert Teardown
- Expert Design
- Expert Test Services
- Expert Assortment Analysis</bpmn:text>
