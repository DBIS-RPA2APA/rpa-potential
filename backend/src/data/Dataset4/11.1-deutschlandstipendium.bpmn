    <bpmn:textAnnotation id="TextAnnotation_1xj24bk">
      <bpmn:text>Applicant data is read from the applicant database using the barcode. Before scanning the barcode, access to applicant data is not possible.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_13gcod9" associationDirection="None" sourceRef="Activity_19c078q" targetRef="TextAnnotation_1xj24bk" />
    <bpmn:textAnnotation id="TextAnnotation_1by73b0">
      <bpmn:text>Automatically generated data export to Excel (only complete applications)</bpmn:text>
