    <bpmn:textAnnotation id="TextAnnotation_0s3t0cj">
      <bpmn:text>Maintenance of data only possible through the doctoral office</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0t98v4y" associationDirection="None" sourceRef="Event_1e6zbat" targetRef="TextAnnotation_0s3t0cj" />
    <bpmn:textAnnotation id="TextAnnotation_0xia8vt">
      <bpmn:text>Data maintenance only possible through office of academic affairs</bpmn:text>
