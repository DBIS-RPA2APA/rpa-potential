    <bpmn:participant id="Participant_16hphpw" name="Ulm University" processRef="Process_1" />
    <bpmn:textAnnotation id="TextAnnotation_0966wzk">
      <bpmn:text>Supervisor is already assigned</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1iou9d0" associationDirection="None" sourceRef="Event_0wgugof" targetRef="TextAnnotation_0966wzk" />
    <bpmn:textAnnotation id="TextAnnotation_1bg89qi">
      <bpmn:text>CMS</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0n64adh" associationDirection="None" sourceRef="Activity_1o8vwxj" targetRef="TextAnnotation_1bg89qi" />
    <bpmn:textAnnotation id="TextAnnotation_0x455es">
      <bpmn:text>During registration, the CMS determines whether the applicant is internal (already has an account) or external</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0so2mbc" associationDirection="None" sourceRef="Activity_1o8vwxj" targetRef="TextAnnotation_0x455es" />
    <bpmn:textAnnotation id="TextAnnotation_0drd58u">
      <bpmn:text>CMS</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ej6slg">
      <bpmn:text>All applicants are displayed, and the CMS requires confirmation of whether all requirements are met or not</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1b68poy">
      <bpmn:text>Admission is communicated by the PhD committee (is there a possibility that in the future the PhD committee itself will issue the “acceptance” decision?)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1r3jzk6">
      <bpmn:text>PhD committee</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0vt9yil">
      <bpmn:text>Campus Core</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1ofzfmn" associationDirection="None" sourceRef="Activity_1ra3o23" targetRef="TextAnnotation_0vt9yil" />
    <bpmn:textAnnotation id="TextAnnotation_1ema22e">
      <bpmn:text>CMS</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0mhhril" associationDirection="None" sourceRef="Activity_1ra3o23" targetRef="TextAnnotation_1ema22e" />
    <bpmn:textAnnotation id="TextAnnotation_1wtglm1">
      <bpmn:text>Access to certificates and diplomas for PhD</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0sfs59a" associationDirection="None" sourceRef="Activity_1ra3o23" targetRef="TextAnnotation_1wtglm1" />
    <bpmn:textAnnotation id="TextAnnotation_0xtz29l">
      <bpmn:text>Access to certificates and transcripts for doctoral candidates</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_19a64cb" associationDirection="None" sourceRef="Activity_1ra3o23" targetRef="TextAnnotation_0xtz29l" />
