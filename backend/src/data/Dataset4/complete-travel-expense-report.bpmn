    <bpmn:textAnnotation id="TextAnnotation_1i5dbj8">
      <bpmn:text>Overnight stay register card</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0sezymq" associationDirection="None" sourceRef="Activity_0ey1or8" targetRef="TextAnnotation_1i5dbj8" />
    <bpmn:textAnnotation id="TextAnnotation_17oy46y">
      <bpmn:text>Approve all register cards in travel expense report</bpmn:text>
