    <bpmn:textAnnotation id="TextAnnotation_1c4j7da">
      <bpmn:text>A travel expense report has been submitted</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1abeayw" associationDirection="None" sourceRef="Event_0e5ibx1" targetRef="TextAnnotation_1c4j7da" />
    <bpmn:textAnnotation id="TextAnnotation_0psrecj">
      <bpmn:text>Search is performed based on the reference (here reference Q = QIS settlement)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_14z9249" associationDirection="None" sourceRef="Activity_1y8xvye" targetRef="TextAnnotation_0psrecj" />
    <bpmn:textAnnotation id="TextAnnotation_1u8y2xs">
      <bpmn:text>The reference is changed from Q to E (settled trips)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ca8v3d" associationDirection="None" sourceRef="Activity_155eztm" targetRef="TextAnnotation_1u8y2xs" />
