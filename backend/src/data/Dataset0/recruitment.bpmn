<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_Recruitment"
  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="Process_Recruitment" isExecutable="false">
    <bpmn:startEvent id="R_Start" name="Application received">
      <bpmn:outgoing>R_F1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="R_Screen" name="Screen application">
      <bpmn:incoming>R_F1</bpmn:incoming>
      <bpmn:outgoing>R_F2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="R_Interview" name="Conduct interview">
      <bpmn:incoming>R_F2</bpmn:incoming>
      <bpmn:outgoing>R_F3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="R_GW" name="Hire?">
      <bpmn:incoming>R_F3</bpmn:incoming>
      <bpmn:outgoing>R_F4</bpmn:outgoing>
      <bpmn:outgoing>R_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="R_Offer" name="Send offer">
      <bpmn:incoming>R_F4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="R_Reject" name="Send rejection">
      <bpmn:incoming>R_F5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="R_F1" sourceRef="R_Start" targetRef="R_Screen"/>
    <bpmn:sequenceFlow id="R_F2" sourceRef="R_Screen" targetRef="R_Interview"/>
    <bpmn:sequenceFlow id="R_F3" sourceRef="R_Interview" targetRef="R_GW"/>
    <bpmn:sequenceFlow id="R_F4" sourceRef="R_GW" targetRef="R_Offer"/>
    <bpmn:sequenceFlow id="R_F5" sourceRef="R_GW" targetRef="R_Reject"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_Recruitment">
    <bpmndi:BPMNPlane id="Plane_Recruitment" bpmnElement="Process_Recruitment">

      <bpmndi:BPMNShape id="R_Start_di" bpmnElement="R_Start">
        <dc:Bounds x="120" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="R_Screen_di" bpmnElement="R_Screen">
        <dc:Bounds x="210" y="105" width="150" height="66"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="R_Interview_di" bpmnElement="R_Interview">
        <dc:Bounds x="400" y="105" width="160" height="66"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="R_GW_di" bpmnElement="R_GW">
        <dc:Bounds x="600" y="113" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="R_Offer_di" bpmnElement="R_Offer">
        <dc:Bounds x="720" y="80" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="R_Reject_di" bpmnElement="R_Reject">
        <dc:Bounds x="720" y="160" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="R_F1_di" bpmnElement="R_F1">
        <di:waypoint x="156" y="138"/>
        <di:waypoint x="210" y="138"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="R_F2_di" bpmnElement="R_F2">
        <di:waypoint x="360" y="138"/>
        <di:waypoint x="400" y="138"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="R_F3_di" bpmnElement="R_F3">
        <di:waypoint x="560" y="138"/>
        <di:waypoint x="600" y="138"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="R_F4_di" bpmnElement="R_F4">
        <di:waypoint x="650" y="138"/>
        <di:waypoint x="738" y="98"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="R_F5_di" bpmnElement="R_F5">
        <di:waypoint x="650" y="138"/>
        <di:waypoint x="738" y="178"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
