         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>DS mit Note, ECTS-Note und evtl. Auslands- 
aufenthalt
</text>
      </textAnnotation>
      <textAnnotation id="sid-C6EF19EB-A356-4869-8C14-BD9D4654D323" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>- Abschluss ist generiert
- Zuordnungen prüfen und ggf. ändern
- Benennung der Zusatzfächer, die in das Zeugnis aufgenommen werden sollen</text>
      </textAnnotation>
      <textAnnotation id="sid-641BE966-1BBE-4521-A0B4-1A929104B9B0" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>inklusive Durchschriftsexemplar für Prüfungsakte </text>
      </textAnnotation>
