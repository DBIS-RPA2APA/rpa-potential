# Copy this file to .env (next to compose.yaml) and fill in your key.
# .env is ignored by git and never copied into a Docker image.

OPENROUTER_API_KEY="<your OpenRouter API key>"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
DEFAULT_MODEL="openai/gpt-4o-mini"

# Name under which the dataset in ./dataset appears in the frontend,
# run logs and evaluation history (e.g. Dataset4)
DATASET_NAME="Dataset4"

# Optional evaluation settings
# EVAL_INPUT_MODE="full"                      # full | labelsOnly | structureOnly
# EVAL_EXCLUDE_SUBPROCESS_ACTIVITIES="false"  # true: also skip activities inside subprocesses
